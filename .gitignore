# ============================================================
# 项目：vga-game-tetris-ps-2
# 目录约定（与 README 一致，仓库根即项目根）：
#   src/        RTL 源码（.v / .sv / .vhd）
#   tb/         testbench
#   constrs/    约束（.xdc / .sdc）
#   ip/         IP 配置（.xci）
#   sim/        仿真脚本与交付物（waveforms / results）
#   docs/       文档与运行记录
#   work/       Vivado 工程（本地重建，严禁提交）
# ============================================================

# ============================================================
# Vivado 工程文件夹（严禁提交）
# 每个人在自己的电脑上本地重建，不共享
# ============================================================
work/

# ============================================================
# xsim 工作目录（可重跑生成，不入库）
# 注意：sim/waveforms/、sim/results/、docs/运行记录/ 是交付物，必须入库
#       （见文件末尾的白名单：gitignore 是"最后匹配者生效"）
# ============================================================
sim/work/
sim/work_*/
sim/xsim.dir/
tb/work/
tb/work_*/
tb/xsim.dir/
**/xsim.dir/
**/webtalk/
**/xvlog.log
**/xelab.log
**/xsim.log
**/*.pb
**/*.jou

# 本地临时区（工具检查、运行脚本、草稿，不入库）
.tmp/
dist/                        # 打包输出目录，见 scripts/package.sh

# ============================================================
# 参考材料（第三方 PDF / 参考 RTL，本地参考，不入库）
# 以及 mem/ 下的阶段性记忆 / PDF 文本提取（本地工作文件，不入库）
# ============================================================
ref/
mem/

# ============================================================
# 本地归档区（已退役的实现与旧报告，仅供本机追溯，**不入库**）
# 交付链路由 src/ 下的当前实现承担
# ============================================================
archive/

# ============================================================
# Vivado 在仓库根目录直接运行产生的日志
# ============================================================
vivado*.log
vivado*.jou
.Xil/

# ============================================================
# Vivado / Vitis 自动生成（严禁提交）
# ============================================================
**/.Xil/
**/.gen/
**/.runs/
**/.cache/
**/.hw/
**/.ip_user_files/
**/.sim/
**/.data/
**/.logs/
**/.vitis/
**/.metadata/
*.jou
*.log
*.str
*.dbg
*.webtalk*
*.backup.*
*.pb

# ============================================================
# Vivado 工程描述文件（严禁提交，用 scripts/recreate.tcl 重建）
# ============================================================
*.xpr
*.xpr.user
*.xpr.bak
*.xpr.old
*.xpr.*~
*.xdc.user
*.xdc.bak

# ============================================================
# 编译产物与固件（网盘统一管理）
# ============================================================
*.bit
*.bin
*.elf
*.xsa
*.dcp
*.o
*.a
*.exe
*.d
Debug/
Release/

# ============================================================
# 操作系统垃圾文件
# ============================================================
.DS_Store
Thumbs.db
desktop.ini
__pycache__/
*.pyc

# ============================================================
# 编辑器临时文件
# ============================================================
*.swp
*.swo
*~
.vscode/
.idea/

# ============================================================
# xsim / Vivado 在仓库根目录直接运行掉落的文件（一律不入库）
# 注意 wave_ 规则锚定仓库根（/ 开头），否则会误伤交付波形
# ============================================================
xsim.dir/
xsim.jou
xsim_*.backup.*
webtalk*
xvlog.*
xelab.*
xsim.log
/wave_*.vcd

# ============================================================
# 交付物白名单（**必须放在全文件最末尾**：gitignore 是最后匹配者生效，
# 上面任何 *.log / *.pb / wave_*.vcd 规则都会盖到交付物上）
# ============================================================
!sim/waveforms/
!sim/waveforms/**
!sim/results/
!sim/results/**
!docs/运行记录/
!docs/运行记录/**

# ============================================================
# 生成物例外（**必须写在白名单之后**，否则会被上面的 !sim/results/** 反向放行）
# “放行整个目录”的白名单会把子目录里的生成物一起放进来，
# 所以这些例外要放在它后面 —— 这里踩过一次坑，别再挪位置。
# ============================================================
sim/results/work_synth/
sim/results/work_impl/
sim/results/work_*/